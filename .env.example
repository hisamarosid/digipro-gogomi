# Application
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Gogomi Store"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (MySQL) - use a SEPARATE database for development, never production
DATABASE_URL="mysql://user:password@localhost:3306/digipro_dev"

# Auth & Security - generate with: openssl rand -hex 32
AUTH_SECRET=""
ENCRYPTION_KEY=""
CRON_SECRET=""
# JSON array of old keys that are only used to decrypt legacy records
LEGACY_DECRYPTION_KEYS=""

# AutoGoPay Payment Gateway
AUTOGOPAY_BASE_URL="https://v1-gateway.autogopay.site"
AUTOGOPAY_API_KEY=""

# SMTP Email
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
MAIL_FROM_NAME="Gogomi Store"
MAIL_REPLY_TO=""
ALLOW_REAL_EMAIL_IN_NON_PRODUCTION=false

# Initial Super Admin (used by seed / init scripts only)
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""

# Telegram admin notifications
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# Cloudinary
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Inbound mail (verification codes) webhook
TMAIL_WEBHOOK_SECRET=""

# Payment simulator (admin testing). Keep false in production.
ENABLE_PAYMENT_SIMULATOR=false
