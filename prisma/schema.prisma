model LoyaltyTier {
  id                                    String              @id @default(cuid())
  name                                  String
  slug                                  String              @unique
  rank                                  Int                 @default(1) // 1=Bronze, 2=Silver, 3=Gold, 4=Platinum
  status                                TierStatus          @default(ACTIVE)
  minimumSpend                          Int                 @default(0) // Minimum lifetime spend in IDR
  minimumCompletedOrders                Int?                @default(0)
  coinRewardMultiplier                  Float               @default(1.0)
  maxCoinRedemptionPercentageOverride   Int?                // e.g. 40% override
  renewalDiscountPercentage             Float?              @default(0)   // e.g. 5% renewal discount
  prioritySupportEnabled                Boolean             @default(false)
  replacementCooldownMultiplier         Float?              @default(1.0)
  earlyRestockMinutes                   Int?                @default(0)
  exclusiveAccessEnabled                Boolean             @default(false)
  badgeLabel                            String?             @default("Bronze Member")
  description                           String?
  createdAt                             DateTime            @default(now())
  updatedAt                             DateTime            @updatedAt

