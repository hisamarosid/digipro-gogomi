  supplierId            String?
  supplierClaimEligible Boolean                @default(true)
  createdAt             DateTime               @default(now())
  resolvedAt            DateTime?

  supplier Supplier?              @relation(fields: [supplierId], references: [id])
  claims   SupplierWarrantyClaim[]

  @@index([assetType, assetId])
  @@index([supplierId])
  @@index([status])
}

model SupplierWarrantyClaim {
  id                           String                      @id @default(cuid())
  claimNumber                  String                      @unique // SC-20260815-0001
  supplierId                   String
  sourceType                   ClaimSourceType             @default(CUSTOMER_REPLACEMENT)
  assetType                    InventoryAssetType
  assetId                      String
  incidentId                   String?
  relatedReplacementId         String?
  status                       SupplierWarrantyClaimStatus @default(DRAFT)
  failureReason                InventoryFailureReason
  failureDescription           String?
  warrantyEligibility          Boolean                     @default(true)
  ineligibilityReason          WarrantyIneligibilityReason?
  warrantyEndsAt               DateTime?
  claimDeadlineAt              DateTime?
  claimValue                   Int                         @default(0)
  submittedAt                  DateTime?
  submissionChannel            SupplierContactMethod?
  supplierClaimReference       String?
  waitingSince                 DateTime?
  resolutionType               SupplierClaimResolutionType?
  resolutionAmount             Int?
  supplierResponseReference    String?
  approvedAt                   DateTime?
  rejectedAt                   DateTime?
  resolvedAt                   DateTime?
  closedAt                     DateTime?
  internalNotes                String?
  supplierNameSnapshot         String?
  warrantyPolicyNameSnapshot   String?
  warrantyDaysSnapshot         Int?
  claimDeadlineSnapshot        Int?
  claimValueSnapshot           Int?
  createdBy                    String?
  updatedBy                    String?
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt

  supplier         Supplier                       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  incident         InventoryFailureIncident?      @relation(fields: [incidentId], references: [id])
  replacementLink  ReplacementRequest?            @relation(fields: [relatedReplacementId], references: [id])
  responses        SupplierClaimResponse[]
  evidences        SupplierClaimEvidence[]
  recoveries       SupplierRecovery[]
  replacementLinks SupplierClaimReplacementLink[]

  @@index([supplierId, status])
  @@index([status, claimDeadlineAt])
  @@index([assetType, assetId])
  @@index([claimNumber])
  @@index([createdAt])
}

model SupplierClaimReplacementLink {
  id            String   @id @default(cuid())
  claimId       String
  replacementId String
  createdAt     DateTime @default(now())

  claim       SupplierWarrantyClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  replacement ReplacementRequest    @relation(fields: [replacementId], references: [id], onDelete: Cascade)

  @@unique([claimId, replacementId])
  @@index([claimId])
  @@index([replacementId])
}

model SupplierClaimResponse {
