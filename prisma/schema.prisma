model SupplierWarrantyPolicy {
  id                       String            @id @default(cuid())
  supplierId               String
  name                     String
  warrantyDays             Int?
  claimDeadlineDays        Int?
  claimStartsFrom          WarrantyStartFrom @default(PURCHASE_DATE)
  replacementAllowed       Boolean           @default(true)
  refundAllowed            Boolean           @default(true)
  partialRefundAllowed     Boolean           @default(true)
  supplierCreditAllowed   Boolean           @default(true)
  requiredEvidence         String?           // JSON array string
  defaultClaimInstructions String?
  claimMessageTemplate     String?
  notes                    String?
  status                   String            @default("ACTIVE")
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

