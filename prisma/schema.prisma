  tier LoyaltyTier  @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tierId])
}

model CustomerLoyaltyTierHistory {
  id                     String   @id @default(cuid())
  userId                 String
  fromTierId             String?
  toTierId               String
  reason                 String?
  qualifiedSpendSnapshot Int      @default(0)
  changedAt              DateTime @default(now())

