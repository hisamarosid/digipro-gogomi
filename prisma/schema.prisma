model CustomerOffer {
  id                   String          @id @default(cuid())
  name                 String
  description          String?
  status               OfferStatus     @default(ACTIVE)
  offerType            OfferType       @default(DISCOUNT)
  discountType         String          @default("PERCENTAGE") // PERCENTAGE or FIXED
