  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([enabled])
}

model VerificationRequest {
  id               String                    @id @default(cuid())
  userId           String
  orderItemId      String
  inventoryItemId String?
  sharedAccountId  String?
  familyGroupId    String?
  mailboxId        String?
  provider         String                    @default("GENERIC")
  status           VerificationRequestStatus @default(WAITING)
  requestedAt      DateTime                  @default(now())
  expiresAt        DateTime
  fulfilledAt      DateTime?
  codeEventId      String?
  codeFound        String?                   // Encrypted at rest
  reason           String?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderItemId])
  @@index([sharedAccountId])
  @@index([familyGroupId])
  @@index([inventoryItemId])
  @@index([status])
  @@index([expiresAt])
}

model VerificationCodeEvent {
  id                 String                      @id @default(cuid())
  mailboxId          String?
  provider           String                      @default("GENERIC")
  sender             String
  subject            String
  codeEncrypted      String
  receivedAt         DateTime                    @default(now())
  expiresAt          DateTime
  confidence         String                      @default("HIGH")
  status             VerificationCodeEventStatus @default(UNCLAIMED)
  claimedByRequestId String?
  claimedAt          DateTime?
  messageIdHash      String?                     @unique

  @@index([mailboxId])
  @@index([provider])
  @@index([status])
  @@index([receivedAt])
  @@index([expiresAt])
}



